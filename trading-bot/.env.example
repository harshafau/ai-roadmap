# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------------
# Dhan: generate from https://web.dhan.co
#   My Profile -> DhanHQ Trading APIs -> Generate Access Token
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# paper | live   (live also requires --i-understand-live-trading on the CLI)
EXECUTION_MODE=paper

# SQLite ledger path (paper trades + portfolio snapshots)
DATABASE_URL=sqlite:///trading.db

# Logging
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Telegram push notifications (OPTIONAL — leave empty to disable).
# Setup:
#   1. On Telegram, message @BotFather -> /newbot. Save the bot token.
#   2. Open the new bot in Telegram and send it any message.
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in a browser.
#      Copy the numeric "chat":{"id": ...} value.
#   4. Run: trading-bot test-telegram   to verify it works.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
